# Copy to /etc/meteo-rtl-sdr/weather-underground.env on the host.
WU_STATION_ID=CHANGE_ME
WU_PASSWORD=change-me
METEO_MODEL=Fineoffset-WHx080
METEO_CSV_LOG=/var/lib/meteo-rtl-sdr/rtl_433.csv
METEO_STATE_DIR=/var/lib/meteo-rtl-sdr/state
MAX_DATA_AGE_SECONDS=600
MAX_FUTURE_SKEW_SECONDS=60
WU_DRY_RUN=0

# Configuration for bin/meteo-rtl433-runner.sh

# Use system rtl_433 by default. If you built from source, set an absolute path.
RTL433_BIN="rtl_433"
RTL433_LIBRARY_PATH=

# Common values: 433.92M, 868.176M
RTL433_FREQUENCY=433.92M

# Leave empty for default, or set index/serial.
RTL433_DEVICE=

# rtl_433 protocol IDs. Empty means autodetection.
# Example: RTL433_PROTOCOLS="19 40"
RTL433_PROTOCOLS=

# Extra rtl_433 args, for example gain.
RTL433_SAMPLE_RATE=250k
RTL433_EXTRA_ARGS="-Y classic"

# Output paths.
RTL433_LOG_DIR="/var/lib/meteo-rtl-sdr"
RTL433_CSV="$RTL433_LOG_DIR/rtl_433.csv"
RTL433_JSONL="$RTL433_LOG_DIR/rtl_433.jsonl"
RTL433_ENABLE_JSON=1
RTL433_ENABLE_CSV=1

# MQTT is optional. Leave empty when unused.
# Example: localhost:1883,user=meteo,pass=secret
RTL433_MQTT_URL=
RTL433_MQTT_TOPIC="meteo/rtl_433[/model][/id]"
